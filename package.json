{
  "name": "youtube-thumbnail-blur",
  "version": "1.1.0",
  "private": true,
  "description": "Chrome extension that blurs every YouTube thumbnail, including dynamically loaded content",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check src tests",
    "format": "prettier --write src tests",
    "icons:build": "node scripts/build-icons.mjs",
    "zip": "npm run build && cd dist && zip -r ../youtube-thumbnail-blur-v$npm_package_version.zip ."
  },
  "dependencies": {
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.4",
    "@types/chrome": "^0.2.9",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.2",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
